# Multi-LeadGen AI — Production VPS Environment Configuration
# Copy this file to .env on your VPS before running docker-compose.prod.yml:
# cp .env.production.example .env

ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Generate a strong 64-char key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_32_character_secret_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Superadmin Credentials (created on first run)
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=change_this_to_a_strong_password_123!

# Database (PostgreSQL 16 in Docker network)
POSTGRES_USER=leadgen_prod
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_DB=leadgen_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen_prod:generate_strong_db_password_here@postgres:5432/leadgen_prod

# Cache & Task Broker (Redis in Docker network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Production Ports (bind to localhost if behind Nginx/Caddy reverse proxy)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# OpenClaw Headless Crawler Gateway
OPENCLAW_GATEWAY_URL=https://openclaw.yourdomain.com
OPENCLAW_GATEWAY_TOKEN=your_production_openclaw_token
OPENCLAW_WEBHOOK_TOKEN=your_production_webhook_token

# Worker Fleet Configuration
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

# Frontend API Endpoint (URL accessed by user browsers)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Optional AI & Integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GROQ_API_KEY=
OPENAI_API_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# Outbound Cold Outreach Email (SMTP)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=outreach@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=outreach@yourdomain.com
SMTP_FROM_NAME="Growth Partnership Team"

# Inbound Email Reply Tracking (IMAP)
IMAP_HOST=imap.yourdomain.com
IMAP_PORT=993
IMAP_USER=outreach@yourdomain.com
IMAP_PASSWORD=your_imap_password
IMAP_POLL_INTERVAL_SECONDS=180
