# ==============================================================================
# Production Environment Variables (.env for VPS deployment)
# ==============================================================================

# Images (Defaults to GitHub Container Registry)
BACKEND_IMAGE=ghcr.io/jamilkhanemon/multi-lead-gen-backend:latest
FRONTEND_IMAGE=ghcr.io/jamilkhanemon/multi-lead-gen-frontend:latest

# App Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secure_secret_key_at_least_32_chars

# Ports to expose on your VPS host
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL 16 Credentials
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=leadgen

# OpenClaw Gateway (Cloud or Native Instance)
OPENCLAW_GATEWAY_URL=https://darkblue-antelope-685588.hostingersite.com
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token
OPENCLAW_WEBHOOK_TOKEN=your_openclaw_webhook_token

# Ollama Instance (If Ollama is running natively on VPS host or external server)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Worker Concurrency
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

# Meta Ads API (Optional)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# Google Gemini / Veo / Imagen API Key (Optional)
GOOGLE_API_KEY=

# Public Frontend API URL (Set to your domain or VPS IP: e.g. http://your-vps-ip:8000/api/v1 or /api/v1)
NEXT_PUBLIC_API_URL=/api/v1
