# ==============================================================================
# 🎯 LeadGen AI — VPS Production Environment Template (.env.production.example)
# ==============================================================================
# 📌 INSTRUCTIONS FOR VPS DEPLOYMENT:
# 1. On your VPS server, copy this template to '.env':
#    cp .env.production.example .env
# 2. Fill in production credentials (strong passwords, production domain/IP, live SMTP).
# 3. Launch Docker Compose: docker compose -f docker-compose.prod.yml up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Image Repositories
# ------------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/nibiz-soft/leadgenai-backend:latest
FRONTEND_IMAGE=ghcr.io/nibiz-soft/leadgenai-frontend:latest

# ------------------------------------------------------------------------------
# 2. Core Server & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ⚠️ CRITICAL: Replace with a unique random secret string (min 32 characters)
SECRET_KEY=change_this_to_a_random_secure_secret_key_at_least_32_chars

# VPS Host ports exposed to internet / reverse proxy
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Credentials (Production Database)
# ------------------------------------------------------------------------------
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=your_strong_production_postgres_password
POSTGRES_DB=leadgen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen:your_strong_production_postgres_password@postgres:5432/leadgen

# ------------------------------------------------------------------------------
# 4. Redis 7 Queue & Cache
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. OpenClaw Autonomous Web Research Gateway
# ------------------------------------------------------------------------------
OPENCLAW_GATEWAY_URL=https://your-openclaw-gateway.example.com
OPENCLAW_GATEWAY_TOKEN=your_production_openclaw_gateway_token
OPENCLAW_WEBHOOK_TOKEN=your_production_openclaw_webhook_token

# ------------------------------------------------------------------------------
# 6. Worker Performance Controls
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. Live Production Email Outreach (SMTP Configuration)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@domain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_production_email@domain.com
SMTP_FROM_NAME="LeadGen Sales Team"

# ------------------------------------------------------------------------------
# 8. Frontend Public API Endpoint
# ------------------------------------------------------------------------------
# Set to '/api/v1' if behind NGINX reverse proxy, or 'http://<VPS_IP>:8000/api/v1'
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 9. Optional Integrations (Meta Ads & Google Gemini)
# ------------------------------------------------------------------------------
# META_ACCESS_TOKEN=your_meta_system_user_access_token
# META_AD_ACCOUNT_ID=act_your_ad_account_id
# META_PAGE_ID=your_facebook_page_id
# GOOGLE_API_KEY=your_google_api_key
