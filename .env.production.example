BACKEND_IMAGE=ghcr.io/nibiz-soft/leadgenai-backend:latest
FRONTEND_IMAGE=ghcr.io/nibiz-soft/leadgenai-frontend:latest

ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_random_secure_secret_key_at_least_32_chars
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_USER=leadgen
POSTGRES_PASSWORD=your_strong_production_postgres_password
POSTGRES_DB=leadgen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen:your_strong_production_postgres_password@postgres:5432/leadgen

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

OPENCLAW_GATEWAY_URL=https://your-openclaw-gateway.example.com
OPENCLAW_GATEWAY_TOKEN=your_production_openclaw_gateway_token
OPENCLAW_WEBHOOK_TOKEN=your_production_openclaw_webhook_token

WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@domain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_production_email@domain.com
SMTP_FROM_NAME="LeadGen Sales Team"

NEXT_PUBLIC_API_URL=/api/v1
