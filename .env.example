# ==============================================================================
# 🎯 LeadGen AI — Environment Configuration Template (.env.example)
# ==============================================================================
# 📌 INSTRUCTIONS:
# 1. Copy this file to create your active local configuration file:
#    cp .env.example .env
# 2. Fill in or adjust the values below according to your setup.
# 3. NEVER commit your real '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Server Settings
# ------------------------------------------------------------------------------
# Mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Verbosity of system logs: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# API prefix route versioning
API_V1_PREFIX=/api/v1

# Security Secret Key used to sign JWT authentication tokens.
# ⚠️ ALWAYS replace this with a secure random 32+ character string in production!
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_chars_min

# Session expiration time in minutes (1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
# Database user account
POSTGRES_USER=leadgen

# Database password
POSTGRES_PASSWORD=leadgen_secret_pw

# Target database name
POSTGRES_DB=leadgen

# Database host address (use '127.0.0.1' for local dev, or 'postgres' inside Docker)
POSTGRES_HOST=127.0.0.1

# Database port
POSTGRES_PORT=5432

# SQLAlchemy Async Connection URL format:
# postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen_secret_pw@127.0.0.1:5432/leadgen


# ------------------------------------------------------------------------------
# 3. Redis 7 Queue & In-Memory Cache
# ------------------------------------------------------------------------------
# Redis host address (use '127.0.0.1' for local dev, or 'redis' inside Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis Connection URL (Database index 0 by default)
REDIS_URL=redis://127.0.0.1:6379/0


# ------------------------------------------------------------------------------
# 4. OpenClaw Autonomous Research Gateway (Web Crawling & Evidence Extraction)
# ------------------------------------------------------------------------------
# OpenClaw Cloud Gateway Endpoint URL:
# - Local dev fallback: ws://127.0.0.1:18789
# - Cloud Gateway URL: https://your-openclaw-gateway.example.com
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Authentication secret token required for OpenClaw Gateway WebSocket handshake
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here

# Distinct security token for inbound cron/automation webhook validation
OPENCLAW_WEBHOOK_TOKEN=your_openclaw_webhook_token_here


# ------------------------------------------------------------------------------
# 5. Worker Fleet Concurrency & Performance Controls
# ------------------------------------------------------------------------------
# Number of parallel worker threads processing lead research tasks (1 to 4 recommended)
WORKER_CONCURRENCY=2

# Maximum duration (in seconds) permitted per lead research task before timing out
RESEARCH_TIMEOUT_SECONDS=120

# Maximum retry attempts for failed HTTP/WebSocket requests during research
MAX_RETRY_ATTEMPTS=5


# ------------------------------------------------------------------------------
# 6. Email Outreach Engine (SMTP Configuration)
# ------------------------------------------------------------------------------
# Set up your SMTP provider for dispatching outreach emails to qualified leads.
# If left empty, the engine automatically operates in DRY-RUN SIMULATION mode.

# Common Hosts:
# - Gmail / Google Workspace: smtp.gmail.com (Port 587)
# - Zoho Mail: smtp.zoho.com (Port 587)
# - Amazon SES: email-smtp.us-east-1.amazonaws.com (Port 587)
# - SendGrid: smtp.sendgrid.net (Port 587)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com

# 💡 For Gmail: Generate an 16-character "App Password" under Google Account Security settings
SMTP_PASSWORD=your_gmail_app_password_here

# Sender Email & Display Name appearing in recipient's inbox
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="LeadGen Sales Team"


# ------------------------------------------------------------------------------
# 7. Frontend Client Setup (Next.js 15)
# ------------------------------------------------------------------------------
# Base API URL used by frontend browser requests to communicate with FastAPI
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1


# ==============================================================================
# 🌟 OPTIONAL EXTERNAL INTEGRATIONS
# ==============================================================================

# --- Local Offline LLM Reasoning Fallback (Ollama) ---
# Uncomment if using a local Ollama instance instead of cloud OpenClaw intelligence
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Meta Marketing Ads Graph API Integration ---
# Enables direct publishing of generated ad campaigns to Meta Ads Manager
# META_ACCESS_TOKEN=your_meta_system_user_access_token_here
# META_AD_ACCOUNT_ID=act_your_ad_account_id_here
# META_PAGE_ID=your_facebook_page_id_here

# --- Google Gemini / Imagen 3 / Veo API Key ---
# Required if utilizing Google Gemini LLM or AI media generation endpoints
# GOOGLE_API_KEY=your_google_api_key_here
