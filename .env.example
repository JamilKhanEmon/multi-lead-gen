# ==============================================================================
# 🎯 LeadGen AI — Autonomous B2B Lead Generation & Qualification Engine
# Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace all dummy values with your real configuration.
# 3. NEVER commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security secret key for JWT session signing (Use a random 32+ char string in production)
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Async SQLAlchemy Connection URL
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@127.0.0.1:5432/your_database_name


# ------------------------------------------------------------------------------
# 3. Message Queue & In-Memory Cache (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0


# ------------------------------------------------------------------------------
# 4. OpenClaw Autonomous Research Gateway (Web Scraping & Public Evidence)
# ------------------------------------------------------------------------------
# Example: ws://127.0.0.1:18789 (Local) OR https://your-openclaw-gateway.example.com (Cloud)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
OPENCLAW_WEBHOOK_TOKEN=your_openclaw_webhook_token_here


# ------------------------------------------------------------------------------
# 5. Worker Concurrency & Performance Controls
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5


# ------------------------------------------------------------------------------
# 6. Frontend Client (Next.js 15)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1


# ==============================================================================
# 🌟 OPTIONAL INTEGRATIONS (Only needed if using Local LLM, Live Ads or Gemini)
# ==============================================================================

# --- Optional Local LLM Fallback (Ollama) ---
# If you run a local Ollama instance instead of cloud gateway:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Meta Ads Marketing API ---
# META_ACCESS_TOKEN=your_meta_system_user_access_token_here
# META_AD_ACCOUNT_ID=act_your_ad_account_id_here
# META_PAGE_ID=your_facebook_page_id_here

# --- Google Gemini / Imagen 3 / Veo API ---
# GOOGLE_API_KEY=your_google_api_key_here
