ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_jwt_secret_key_change_me_super_secure_9832749823749823

# Database (PostgreSQL 16)
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_secret_pw
POSTGRES_DB=leadgen
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen_secret_pw@127.0.0.1:5432/leadgen

# Queue & Cache (Redis 7)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
