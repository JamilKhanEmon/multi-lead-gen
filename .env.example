ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_secret_pw
POSTGRES_DB=leadgen
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen_secret_pw@127.0.0.1:5432/leadgen

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
OPENCLAW_WEBHOOK_TOKEN=your_openclaw_webhook_token_here

WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="LeadGen Sales Team"

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
