# OpenClaw Autonomous Research Gateway (Loopback Protocol 4)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=oc_dev_gateway_token_change_me_super_secure
OPENCLAW_WEBHOOK_TOKEN=oc_dev_webhook_token_change_me_distinct_secret

# Ollama Multimodal Local Intelligence
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Worker Concurrency & Performance (Optimized for 16GB RAM)
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

