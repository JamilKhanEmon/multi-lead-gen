# Multi-LeadGen AI — Local Development Environment Configuration
# Copy this file to .env before running local services:
# cp .env.example .env

ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_random_32_character_secret_key_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL 16)
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_secret_pw
POSTGRES_DB=leadgen
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen_secret_pw@127.0.0.1:5432/leadgen

# Cache & Task Broker (Redis 7)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# OpenClaw Headless Crawler Gateway
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
OPENCLAW_WEBHOOK_TOKEN=your_openclaw_webhook_token_here

# Worker Fleet Configuration
WORKER_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=5

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional AI & Integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GROQ_API_KEY=
OPENAI_API_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# Optional Outbound Cold Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Growth Partnership Team"

# Optional Inbound Reply Tracking (IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SECONDS=180
